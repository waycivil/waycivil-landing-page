---
const currentYear = new Date().getFullYear();
const privateSiteUrl = import.meta.env.PRIVATE_SITE_URL || "";
---

<footer class="w-full bg-background py-10 full:py-12">
  <div class="mx-auto max-w-7xl px-6 maxwidth:px-0">
    <div class="flex flex-col gap-10 full:gap-12 laptop:flex-row laptop:justify-between">
      <!-- Logo and Description -->
      <div class="shrink-0 laptop:max-w-xs">
        <a href="/" class="mb-2 inline-block text-2xl font-bold text-foreground hover:cursor-pointer">
          <div class="flex items-center gap-2">
            <img src="/waycivil-logo.svg" alt="WayCivil Logo" class="h-6" />
            <span>
              Way<span class="text-primary">Civil</span>
            </span>
          </div>
        </a>
        <p class="text-sm full:text-base text-foreground/60">AI-powered civil engineering reviews for the future</p>
      </div>

      <div class="text-sm full:text-base flex flex-col gap-8 laptop:flex-row laptop:gap-13 full:gap-24">
        <!-- Product -->
        <div>
          <h4 class="mb-3 font-semibold text-foreground">Product</h4>
          <ul class="space-y-2">
            <li>
              <a href="/quality-checks" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Quality Checks
              </a>
            </li>
            <li>
              <a href="/pricing" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Pricing
              </a>
            </li>
          </ul>
        </div>

        <!-- Company -->
        <div>
          <h4 class="mb-3 font-semibold text-foreground">Company</h4>
          <ul class="space-y-2">
            <li>
              <a href="/about" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                About
              </a>
            </li>
            <li>
              <a href="/contact" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Contact
              </a>
            </li>
          </ul>
        </div>

        <!-- Legal -->
        <div>
          <h4 class="mb-3 font-semibold text-foreground">Legal</h4>
          <ul class="space-y-2">
            <li>
              <a href="/legal/terms" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Terms and Conditions
              </a>
            </li>
            <li>
              <a href="/legal/privacy" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Privacy Policy
              </a>
            </li>
            <li>
              <a href="/legal/dpa" class="text-foreground/60 transition-colors hover:cursor-pointer hover:text-primary-hover">
                Data Processing Agreement
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 border-t border-border pt-8">
      <div class="flex flex-col items-center justify-between gap-4 text-xs full:text-sm text-foreground/60 laptop:flex-row">
        <p>&copy; {currentYear} WayCivil. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/company/waycivil"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground/60
             transition-colors hover:cursor-pointer hover:border-primary-hover hover:text-primary-hover"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"></path>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@waycivil.web"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground/60
             transition-colors hover:cursor-pointer hover:border-primary-hover hover:text-primary-hover"
            aria-label="TikTok"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z" />
            </svg>
          </a>
          <!-- YouTube -->
          <a
            href="https://www.youtube.com/@WayCivil"
            class="flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground/60
             transition-colors hover:cursor-pointer hover:border-primary-hover hover:text-primary-hover"
            aria-label="YouTube"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
