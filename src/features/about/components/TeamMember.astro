---
interface Props {
  image: string;
  name: string;
  role: string;
  description: string;
  linkedinHref: string;
}

const { image, name, role, description, linkedinHref } = Astro.props;
---

<div class="flex flex-col full:flex-row gap-6 items-center justify-center">
  <img src={image} class="rounded-full h-46 w-46 object-cover" />
  <div class="flex flex-col gap-1 items-center">
    <h4 class="text-xl tablet:text-2xl font-bold">{name}</h4>
    <h5 class="text-base tablet:text-lg">{role}</h5>
    <p class="text-subtitle text-sm tablet:text-base">{description}</p>
    <!-- LinkedIn -->
    <a
      href={linkedinHref}
      class="flex h-10 items-center justify-center rounded-full border border-subtitle text-foreground/60 gap-3 px-3 py-1
             transition-colors hover:cursor-pointer hover:border-primary-hover hover:text-primary-hover mt-2"
      aria-label="LinkedIn"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
        <path
          d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"
        ></path>
        <circle cx="4" cy="4" r="2"></circle>
      </svg>
      <span>LinkedIn</span>
    </a>
  </div>
</div>
