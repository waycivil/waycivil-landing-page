---
import TitleSection from "@/components/TitleSection.astro";
import OfferAccordion from "./OfferAccordion";
---

<section class="w-full bg-background px-6 pt-12 tablet:pt-24 pb-24">
  <div class="mx-auto max-w-7xl">
    <TitleSection
      title="WHAT WE OFFER"
      subtitle="Built for your specific QC need"
      content=" We build specific models that adapt to your internal review logic and client standards — while keeping all data fully private."
    />

    <OfferAccordion client:visible />
  </div>
</section>
