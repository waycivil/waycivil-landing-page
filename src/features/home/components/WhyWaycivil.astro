---
// WhyWaycivil component - Why choose WayCivil section
import TitleSection from "@/components/TitleSection.astro";
import FeatureBox from "@/components/FeatureBox";

const features = [
  {
    iconName: "zap" as const,
    title: "Reviews in seconds",
    description: "Upload your PDF and get instant AI feedback",
  },
  {
    iconName: "brain" as const,
    title: "Trained with 1,000+ real plans",
    description: "Built from real QC mistakes, not just LLM prompts.",
  },
  {
    iconName: "clock" as const,
    title: "24/7 available",
    description: "Always ready when your project needs it.",
  },
];
---

<section class="w-full bg-background px-6 pt-0 tablet:pt-4 pb-24">
  <div class="mx-auto max-w-7xl">
    <TitleSection
      title="Why WayCivil"
      subtitle="Next-Gen Civil Reviews"
      content="Reduce review time by 70% through automatic quality checks per discipline."
    />

    <div class="grid gap-5 full:gap-8 laptop:grid-cols-3">
      {
        features.map((feature) => (
          <FeatureBox
            iconName={feature.iconName}
            title={feature.title}
            description={feature.description}
            client:load
          />
        ))
      }
    </div>
  </div>
</section>
