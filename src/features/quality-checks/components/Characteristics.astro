---
import { Brain, GlobeLock, Table, Timer, Users, Zap } from "lucide-react";
import CharacteristicItem from "./CharacteristicItem";

const characteristics = [
  {
    Icon: Brain,
    title: "Company-Aligned AI",
    description:
      "Train custom AI review models that understand and apply your company's specific standards, criteria, and workflows—no generic templates.",
  },
  {
    Icon: Timer,
    title: "5-Minute Reviews",
    description:
      "Generate complete QC plan reviews in under 5 minutes instead of spending days or weeks on manual review processes.",
  },
  {
    Icon: Zap,
    title: "Zero Configuration Required",
    description:
      "Start reviewing civil engineering projects instantly with no complex setup, integrations, or technical configuration needed.",
  },
  {
    Icon: Users,
    title: "Collaborative Review Management",
    description:
      "Centralize all your QC reviews in one place where team members can manage, explore, and update AI-generated comments together in real-time.",
  },
  {
    Icon: Table,
    title: "Fully Customizable Parameters",
    description:
      "Tailor each review by specifying track type, applicable standards, intensity level, and additional requirements for precise results.",
  },
  {
    Icon: GlobeLock,
    title: "Private & Encrypted by Default",
    description:
      "Enterprise-grade security ensures your projects and plans remain fully private and encrypted, accessible only to your authorized team.",
  },
];
---

<div
  class="mx-auto w-full max-w-content px-6 maxwidth:px-0 grid grid-cols-1 tablet:grid-cols-2 laptop:grid-cols-3 
  gap-x-10 full:gap-x-15 gap-y-10 tablet:gap-y-15 pt-32"
>
  {
    characteristics.map((item) => (
      <CharacteristicItem
        Icon={item.Icon}
        title={item.title}
        description={item.description}
      />
    ))
  }
</div>
