---
import { BackgroundBeams } from "@/components/ui/background-beams";

// HeroBackground component - Background effects for hero section
---

<div
  class="relative flex h-[675px] w-full flex-col items-center justify-center overflow-hidden bg-linear-to-b
   from-[#1a0c06] via-[#0f0805] to-background"
>
  <div
    class="absolute inset-0
     bg-[radial-gradient(ellipse_at_top,rgba(249,115,22,0.15)_0%,rgba(194,65,12,0.08)_40%,transparent_70%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-linear-to-b from-[#C2410C]/10 via-transparent to-transparent"
  >
  </div>

  <!-- Content slot -->
  <slot />

  <!-- Background Beams Effect -->
  <BackgroundBeams client:load/>
</div>
