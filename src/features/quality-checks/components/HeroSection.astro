---
// HeroSection component - Hero section with background effects
import HeroBackground from "./HeroBackground.astro";
import SpecialButton from "@/features/home/components/SpecialButton";
---

<HeroBackground>
  <div
    class="relative z-10 mx-auto max-w-content px-6 maxwidth:px-0 pt-46 pb-32 text-center"
  >
    <span class="text-primary uppercase text-base tablet:text-lg font-bold"
      >WayCivil QC®</span
    >
    <h1
      class="mb-6 text-balance font-sans text-4xl tablet:text-5xl font-bold leading-tight tracking-tight text-foreground
      laptop:text-6xl full:text-7xl"
    >
      The Future of Plan Reviews<br />
      <span
        class="bg-linear-to-r from-primary to-[#C2410C] bg-clip-text text-transparent"
        >Starts Here</span
      >
    </h1>

    <p
      class="mx-auto mb-10 max-w-2xl text-pretty text-sm tablet:text-base full:text-lg leading-relaxed text-subtitle"
    >
      Generate instant QC reviews and manage, edit, and track all your project
      comments in one place.
    </p>

    <!-- Buttons -->
    <div
      class="flex flex-col items-center justify-center gap-4 tablet:flex-row w-full"
    >
      <a href="/quality-checks" class="w-full tablet:w-fit">
        <button
          class="bg-primary text-sm rounded-md font-medium text-foreground hover:bg-primary-hover px-6 py-2.5
        cursor-pointer w-full tablet:w-fit"
        >
          Get started
        </button>
      </a>

      <SpecialButton client:load />
    </div>
  </div>
</HeroBackground>
