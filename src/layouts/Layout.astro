---
import { ViewTransitions } from "astro:transitions";
import Navbar from "@/components/layout/Navbar";
import Footer from "@/components/layout/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  type?: "website" | "article" | "product";
  canonical?: string;
}

const {
  title = "Custom AI QC Plan Reviewer | WayCivil",
  description = "Review your QC plans in minutes based on custom AI models done just for you.",
  keywords = "civil engineering, QC, plan reviews, AI",
  image = "/waycivil-logo.png",
  type = "website",
  canonical,
} = Astro.props;

// Build URLs - handle development vs production
const siteURL = Astro.site?.href || "http://localhost:4321";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteURL).href;
const imageURL = new URL(image, siteURL).href;

// Get private site URL from environment
const privateSiteUrl = import.meta.env.PRIVATE_SITE_URL || "";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WayCivil",
  url: siteURL,
  logo: new URL("/waycivil-logo.svg", siteURL).href,
  description: description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="WayCivil" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="WayCivil" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/waycivil-logo.svg" />
    <link rel="icon" type="image/png" href="/waycivil-logo.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/waycivil-logo.png" />

    <!-- Theme Color -->
    <meta name="theme-color" content="#000" />

    <!-- Structured Data (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <!-- View Transitions for smooth navigation -->
    <ViewTransitions />
  </head>
  <body class="relative w-full h-full m-0 min-h-screen flex flex-col">
    <Navbar privateSiteUrl={privateSiteUrl} client:load />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
