---
import ContactForm from "@/features/contact/components/ContactForm";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Contact Us | WayCivil"
  description="Get in touch with us to start building your custom AI model adapted to your company's standard."
>
  <section class="bg-primary/30 h-full">
    <div
      class="relative flex w-full flex-col items-center pt-32 overflow-hidden bg-linear-to-b
   from-[#1a0c06] via-[#0f0805] to-background"
    >
      <div
        class="absolute inset-0
     bg-[radial-gradient(ellipse_at_top,rgba(249,115,22,0.15)_0%,rgba(194,65,12,0.08)_40%,transparent_70%)]"
      >
      </div>
      <div
        class="absolute inset-0 bg-linear-to-b from-[#C2410C]/10 via-transparent to-transparent"
      >
      </div>

      <div
        class="relative w-full mx-auto max-w-content px-6 maxwidth:px-0 flex flex-col items-center gap-10 pb-20"
      >
        <ContactForm client:load />
      </div>
    </div>
  </section>
</Layout>
