---
import LegalLayout from "@/features/legal/components/LegalLayout.astro";
import PrivacyContent from "@/features/legal/components/PrivacyContent.astro";
import PrivacyIndex from "@/features/legal/components/PrivacyIndex";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Privacy Policy | WayCivil"
  description="WayCivil's Privacy Policy explaining how we collect, use, and protect your personal information."
>
  <section class="bg-background h-full">
    <LegalLayout title="Privacy Policy" lastUpdated="December 5, 2025">
      <PrivacyIndex client:load />
      <PrivacyContent />
    </LegalLayout>
  </section>
</Layout>
