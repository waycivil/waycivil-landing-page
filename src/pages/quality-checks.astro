---
import HeroSection from "@/features/quality-checks/components/HeroSection.astro";
import Layout from "../layouts/Layout.astro";
import StepsSection from "@/features/quality-checks/components/StepsSection.tsx";
import CustomSolution from "@/components/CustomSolution";
import Characteristics from "@/features/quality-checks/components/Characteristics.astro";
---

<Layout
  title="AI QC Plan Reviews | WayCivil"
  description="Review your civil engineering QC plans in minutes with custom AI models trained on your company's standards and requirements."
>
  <section class="bg-background h-full pb-20 relative overflow-hidden">
    <HeroSection />
    <StepsSection client:visible />
    <Characteristics />
    <CustomSolution
      title="Ready to start?"
      subtitle="Get in touch with our sales team to discuss enterprise plans, custom integrations, and dedicated support for your organization."
    />
  </section>
</Layout>
